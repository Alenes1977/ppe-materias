# Backend SAML2 / CAS (server/).
#
# Con NODE_ENV=production el proceso NO arranca si falta SESSION_SECRET, si es
# el valor de ejemplo o tiene menos de 32 caracteres, o si APP_BASE_URL no usa
# https. El ALB de ECS sigue comprobando GET /health (sin autenticación).

# En ECS ya está PORT=8181. En local, 8181 también (Vite queda en 5173).
PORT=8181

# Origen público de la app y del ACS: {APP_BASE_URL}/api/auth/cas/callback.
# En producción coincide con el EntityID. En local, tras el login se redirige
# a Vite (DEV_FRONTEND_URL, por defecto :5173).
APP_BASE_URL=http://localhost:5173
# DEV_FRONTEND_URL=http://localhost:5173

# EntityID del SP registrado en CAS.
SAML_ISSUER=https://guiadocente.unav.edu

# Base del IdP. El entry point SAML se deriva como
# {CAS_BASE_URL}/idp/profile/SAML2/Redirect/SSO salvo que se fije SAML_ENTRY_POINT.
# Producción: https://cas.unav.es/cas
CAS_BASE_URL=https://caspre.unav.es/cas

# Certificado público del IdP (PEM). Por defecto caspre.crt en desarrollo y
# cas.crt en producción.
# SAML_IDP_CERT_PATH=

# Genera uno propio, p. ej.: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
